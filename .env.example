# Node.js 24+. Aucun secret dans Git.
PORT=3000
SITE_MODE=preview
# URL publique absolue, sans slash final (nécessaire pour Stripe et canonical).
SITE_URL=
# Facultatif : sinon un mot de passe local aléatoire est créé dans .data/admin-password.
ADMIN_PASSWORD=
# Passer à true uniquement lorsque le site est servi via HTTPS.
COOKIE_SECURE=false
# Messagerie : SMTP avec TLS vérifié. Configurer un compte appartenant à Sirius.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
CONTACT_EMAIL=
# Seules les clés Stripe de TEST sont acceptées dans cette version.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
