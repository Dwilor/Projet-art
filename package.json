{
  "name": "sirius-atelier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist/server",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/check-browser.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "format": "prettier --write src server scripts tests vite.config.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "nodemailer": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^20.0.0",
    "zod": "^4.1.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.9",
    "vite": "^7.2.0"
  }
}
